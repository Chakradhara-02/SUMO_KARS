<configuration>
  <input>
    <net-file value="../network/road.net.xml"/>
    <route-files value="../routes/traffic.rou.xml"/>
    <additional-files value="../additional/zones.add.xml"/>
  </input>
  <time><step-length value="0.2"/><end value="200"/></time>
  <processing><collision.action value="warn"/><time-to-teleport value="-1"/></processing>
  <report><no-step-log value="true"/><duration-log.disable value="true"/></report>
</configuration>
